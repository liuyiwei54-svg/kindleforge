# ── KindleForge server configuration ─────────────────────────────────────────
# Every value is optional; the values shown are the defaults. Integers only.
# Invalid input falls back to the default; out-of-range input is clamped to the
# nearest bound. Either way you get one `[config] …` warning in the server log.
# Restart the server (or container) after changing these.

# Hard upload cap in bytes (default 200 MB).
KF_MAX_UPLOAD_BYTES=209715200

# How long a finished/failed job stays downloadable before its temp files are
# deleted (default 10 minutes).
KF_JOB_TTL_MS=600000

# How many conversions may run at once (1–16, default 2).
# Note: uploads are buffered in memory (the whole multipart form) before the
# conversion starts. Budget roughly maxConcurrency × (upload cap + overhead) of
# RAM, or lower both values on a small instance.
KF_MAX_CONCURRENCY=2

# Per-IP conversions per hour for remote clients (default 20).
KF_RATE_LIMIT_PER_HOUR=20

# Bucket used when KF_TRUST_PROXY=false (all direct callers share it), and for
# loopback when a trusted proxy reports it: default 200/hour, 8 concurrent.
# Spoofed X-Forwarded-For cannot create new identities in direct mode, and a
# self-hosted single user keeps batch-upload headroom.
KF_RATE_LIMIT_LOCAL_PER_HOUR=200

# Trust X-Forwarded-For / X-Real-IP from a reverse proxy YOU control.
# Keep this false unless a proxy overwrites those headers: when false the
# headers are ignored and every caller shares one bucket, so a client cannot
# mint new identities by spoofing X-Forwarded-For. Set true only behind
# nginx/Cloudflare/Traefik that sets the header itself.
KF_TRUST_PROXY=false

# Hard conversion timeout in milliseconds (default 5 minutes).
KF_CONVERT_TIMEOUT_MS=300000

# Boot sweep: delete orphan job directories older than this (default 24 hours).
KF_ORPHAN_MAX_AGE_MS=86400000

# Refuse uploads when the temp volume has less free space than this
# (default 2 GB). Lower it if you mount a small tmpfs, e.g. 512 MB:
#   KF_MIN_FREE_BYTES=536870912
KF_MIN_FREE_BYTES=2147483648

# Optional: absolute path to calibre's ebook-convert when it is not on PATH and
# not in the usual macOS app-bundle location.
# KINDLEFORGE_CALIBRE=/Applications/calibre.app/Contents/MacOS/ebook-convert
